NEXT_PUBLIC_SITE_URL=https://pixpromax.com
# Add this after verifying pixpromax.com in Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set the AdSense client ID to let Google verify/review the site. Keep slot IDs empty
# until the site is approved and responsive ad units are created.
# Example client value: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=

# Optional. Analytics loads only after a visitor allows optional services.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
